# ==============================================================================
# Teman Tanyamu - Production Environment Variables (TEMPLATE)
# ==============================================================================
# Copy this file to `production.env` and fill in your own values.
# `production.env` is git-ignored so your real secrets never reach the repo.
#   cp production.env.example production.env
# ==============================================================================

# 1. RUNTIME MODE
# "production" activates the dual-mode security shield (Secure cookies, strict CORS, strict CSRF).
NODE_ENV=production

# 2. CONTAINER PORT
# Internal port the Node.js server listens on inside the Docker container.
# Mapped externally to your host port (e.g. 3001) in docker-compose.yml.
PORT=3000

# 3. COOKIE / SESSION SECRET
# A long, random string used to sign session cookies.
# Generate one, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# 4. GATEWAY ENDPOINT (9Router / provider base URL)
# Boot fallback base URL, used only until DB settings are populated.
# Local 9Router: http://localhost:20128/v1
# Docker bridge to host proxy: http://host.docker.internal:20128/v1
ROUTER_BASE=http://localhost:20128/v1

# 5. GATEWAY API KEY (ROUTER KEY)
# Boot fallback API key for the gateway. Leave blank and set it from the
# Admin Dashboard -> Model Connection instead (DB settings win over env vars).
ROUTER_KEY=
